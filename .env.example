# Copiar a .env.local para el desarrollo local. No incluir credenciales aquí.
# NEXT_PUBLIC_* se incorpora al código del navegador: nunca usar para secretos.

# URL propuesta para el futuro backend local. No confirma su disponibilidad.
# Reservada para la integración HTTP; la interfaz actual no consume esta URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Dirección de la aplicación ACTIVA al ejecutar npm run test:smoke.
# Iniciar antes: npm start -- --hostname 127.0.0.1 --port 3100
ANALOGX_TEST_URL=http://127.0.0.1:3100
